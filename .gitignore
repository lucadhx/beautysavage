# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Cache incrémental TypeScript (régénéré à chaque build ; sinon faux « dirty »
# qui bloquerait un déploiement PROD — cf. garde DEPLOY_SOURCE_DIRTY)
*.tsbuildinfo
**/*.tsbuildinfo

# Env
.env
.env.local
.env.*.local
**/.env

# Logs
*.log
npm-debug.log*
logs/

# Uploads (runtime user content)
backend/uploads/*
!backend/uploads/.gitkeep

# Stockage privé (PDF de contrats — données contractuelles, jamais versionnées)
backend/storage/

# Rapports de migration (générés ; peuvent contenir des données métier + backups PROD)
backend/migration-reports/*
!backend/migration-reports/.gitkeep
!backend/migration-reports/README.md

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Misc
*.local
coverage/
.cache/

# Agent skills (tooling local, vendored docs + symlinks machine-spécifiques)
.agents/
.claude/
skills-lock.json

# Artefacts de recette locale — jamais versionnés.
.recette/
