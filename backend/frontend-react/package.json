{
  "name": "beautysavage-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Monorepo React parallèle (vitrine + manager) — infrastructure R0, ne remplace pas le Vanilla.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:vitrine": "npm run dev --workspace @bs/vitrine",
    "dev:manager": "npm run dev --workspace @bs/manager",
    "build": "npm run build --workspace @bs/vitrine && npm run build --workspace @bs/manager",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default",
    "test:slow": "vitest run --logHeapUsage --reporter=verbose",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "bootstrap-icons": "^1.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
