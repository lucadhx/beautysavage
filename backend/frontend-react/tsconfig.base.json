{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@bs/config": ["packages/config/src/index.ts"],
      "@bs/api-client": ["packages/api-client/src/index.ts"],
      "@bs/auth": ["packages/auth/src/index.ts"],
      "@bs/ui": ["packages/ui/src/index.ts"]
    }
  },
  "include": [
    "global.d.ts",
    "packages/*/src",
    "apps/*/src"
  ]
}
