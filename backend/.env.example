NODE_ENV=development
TEST_MODE=true
PLATFORM_ENVIRONMENT=TEST
PORT=3012
MONGODB_URI=<mongodb-uri>
MONGODB_DB_NAME=beautysavage-database
SESSION_SECRET=<minimum-32-random-characters>
PWD_PEPPER=<random-secret>
CREDENTIAL_VAULT_KEY=<64-hex-characters>
ALLOW_ENV_CREDENTIAL_FALLBACK=false
REACT_OFFICIAL_FRONTEND=true
PUBLIC_SITE_URL=https://beautysavage.ly-solution.com
PANEL_BASE_URL=<panel-base-url>
PANEL_PAIRING_CODE=<pairing-code-issued-by-panel>
PANEL_PROJECT_KEY=beautysavage
